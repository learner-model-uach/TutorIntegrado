{
  "name": "learner-model-gql-template",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "concurrently -m 1 -r pnpm:generate \"next build\" pnpm:pretty:check",
    "predev": "pnpm generate",
    "dev": "concurrently -r next pnpm:gql:watch pnpm:open:browser",
    "generate": "graphql-codegen --config codegen.yaml",
    "gql": "graphql-codegen --config codegen.yaml",
    "gql:watch": "graphql-codegen --config codegen.yaml --watch",
    "open:browser": "wait-on -s 1 http://localhost:3000 && open-cli http://localhost:3000",
    "pretty": "prettier --write \"**/*.{ts,tsx,json,js,jsx}\"",
    "pretty:check": "prettier --check \"**/*.{ts,tsx,json,js,jsx}\"",
    "start": "next start"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.4.0",
    "@chakra-ui/charts": "^3.30.0",
    "@chakra-ui/cli": "^3.30.0",
    "@chakra-ui/react": "3.30.0",
    "@cortex-js/compute-engine": "^0.30.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@graphql-codegen/cli": "^2.4.0",
    "@graphql-codegen/core": "^2.4.0",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@matejmazur/react-katex": "^3.1.3",
    "@tanstack/react-query": "^5.83.0",
    "@vercel/analytics": "^2.0.1",
    "better-react-mathjax": "^2.3.0",
    "framer-motion": "^12.23.12",
    "graphql": "^16.11.0",
    "immutability-helper": "^3.1.1",
    "jsxgraph": "^1.11.1",
    "katex": "0.16.22",
    "localforage": "^1.10.0",
    "mathjax-react": "2.0.1",
    "mathlive": "^0.107.0",
    "mathquill": "0.10.1-a",
    "next": "^15.5.3",
    "next-themes": "^0.4.6",
    "react": "^19.1.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dnd-touch-backend": "16.0.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-joyride": "2.9.3",
    "react-latex-next": "^3.0.0",
    "react-mathquill": "1.0.4",
    "react-super-responsive-table": "^6.0.2",
    "recharts": "^3.5.1",
    "rq-gql": "^0.5.0",
    "serialize-error": "^12.0.0",
    "valtio": "1.2.9",
    "zustand": "5.0.7"
  },
  "devDependencies": {
    "@chakra-ui/cli": "^3.30.0",
    "@graphql-codegen/schema-ast": "^2.4.1",
    "@types/node": "^22.19.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "8.57.0",
    "@typescript-eslint/parser": "8.57.0",
    "concurrently": "^9.2.0",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.3",
    "open-cli": "^8.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "pnpm": ">=11.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@babel/core"
      ],
      "allowedVersions": {
        "graphql": "*",
        "framer-motion": "*"
      }
    }
  }
}
